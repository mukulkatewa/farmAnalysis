# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

PORT=5000
NODE_ENV=development

# Firebase Admin SDK Configuration
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=aivision-7ad26
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@aivision-7ad26.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://aivision-7ad26-default-rtdb.asia-southeast1.firebasedatabase.app

# Sentinel Hub (Copernicus Dataspace) OAuth Client
# Get these from https://dataspace.copernicus.eu/ -> Dashboard -> User Settings -> OAuth clients
SENTINEL_CLIENT_ID=your-sentinel-client-id
SENTINEL_CLIENT_SECRET=your-sentinel-client-secret

# Google Maps key (Maps Static API enabled) - used for the PDF report map
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Groq API key (https://console.groq.com/keys) - used for Analytics AI insights
GROQ_API_KEY=your-groq-api-key

# IMPORTANT: To get the service account credentials:
# 1. Go to Firebase Console
# 2. Click Settings (gear icon) → Project settings
# 3. Click "Service accounts" tab
# 4. Click "Generate new private key"
# 5. Download the JSON file
# 6. Copy the values from the JSON file:
#    - client_email → FIREBASE_CLIENT_EMAIL
#    - private_key → FIREBASE_PRIVATE_KEY (keep the \n characters)

# Model services on Google Cloud Run (defaults are built in)
# DISEASE_API_URL=
# PEST_API_URL=
# INDEXES_API_URL=
# COLLECTOR_API_URL=
