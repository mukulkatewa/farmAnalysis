{
  "name": "agrivision-backend",
  "version": "1.0.0",
  "description": "Backend server for AgriVision application",
  "main": "server.js",
  "type": "module",
  "engines": {"node": "22.x"},
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@opentelemetry/core": "^2.8.0",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev-ai": "nodemon server-simple.js",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.test.json --project demo-farm-analysis --only firestore,database \"node --test tests/rules.emulator.js\"",
    "test:guest-ui": "firebase emulators:exec --config ../firebase.test.json --project demo-farm-analysis --only auth,firestore \"npm --prefix ../frontend run test:browser\""
  },
  "keywords": [
    "agriculture",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^14.5.0",
    "form-data": "^4.0.5",
    "geotiff": "^2.1.3",
    "google-auth-library": "^10.9.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.34.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.10"
  }
}
