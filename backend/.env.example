PORT=5000
NODE_ENV=development

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Database (if using)
DATABASE_URL=your-database-url

# Sentinel Hub (Copernicus Dataspace) OAuth Client
SENTINEL_CLIENT_ID=your-sentinel-client-id
SENTINEL_CLIENT_SECRET=your-sentinel-client-secret

# Reports export saved snapshots and do not call map providers.

# Groq (AI insights on Analytics page)
GROQ_API_KEY=your-groq-api-key

# JWT Secret (if implementing custom auth)
JWT_SECRET=your-jwt-secret

# Model services on Google Cloud Run (defaults are built in)
# DISEASE_API_URL=
# PEST_API_URL=
# COLLECTOR_API_URL=
# LSTM_API_URL=

# Shared analysis limits (UTC day; started operations, including provider failures)
ANALYSIS_USER_DAILY_LIMIT=20
ANALYSIS_GLOBAL_DAILY_LIMIT=500
ANALYSIS_USER_CONCURRENCY=2
ANALYSIS_GLOBAL_CONCURRENCY=10

# Enable after giving the backend identity Cloud Run Invoker access.
CLOUD_RUN_AUTH=false
CORS_ORIGINS=http://localhost:5173
GROQ_MODEL=openai/gpt-oss-20b

# Optional notification delivery; leave unset to disable.
# NOTIFICATION_WEBHOOK_URL=https://your-webhook.example/notifications
# NOTIFICATION_WEBHOOK_SECRET=
